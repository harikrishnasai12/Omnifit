# Copy this file to .env and fill in the values. Never commit .env.

# Required: base URL of the Ollama server that hosts gemma4:12b
OLLAMA_URL=https://your-ollama-server.example.com

# Optional: frontend origins allowed to call the API directly (comma-separated).
# Not needed when the frontend uses the Vite dev proxy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional settings (defaults shown)
# OLLAMA_TIMEOUT_SECONDS=180
# MAX_IMAGE_MB=10
# ENABLE_API_DOCS=false
# HOST=127.0.0.1
# PORT=8000

# Region detection (free OpenStreetMap Nominatim; its policy asks for an
# identifying User-Agent, ideally with a contact address)
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODER_USER_AGENT=OmniFitLive/1.0 (your-contact@example.com)

# Optional: "Sign in with Google". Create an OAuth client ID (type: Web application)
# at https://console.cloud.google.com/apis/credentials and add your site's address
# (e.g. http://localhost:5173) under "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Where user accounts, Style Library images and the catalog are stored (default: data/)
# USER_DATA_DIR=data

# Partner-brand product catalog (refreshed by: python sync_catalog.py)
# CATALOG_DB_PATH=data/catalog.db
# CATALOG_USER_AGENT=OmniFitLiveCatalog/1.0 (your-contact@example.com)
# CATALOG_REQUEST_DELAY_SECONDS=2
# CATALOG_MAX_PAGES_PER_STORE=40
