# Copy this file to .env. Never commit .env.

# Backend address used by the Vite dev proxy. It has no VITE_ prefix,
# so it is never included in the browser bundle.
OMNIFIT_BACKEND_URL=http://127.0.0.1:8000

# Optional, production only: set this if the built frontend is served from a
# different origin than the API. Anything with a VITE_ prefix IS visible
# in the browser, so never put secrets here.
# VITE_API_BASE_URL=https://api.example.com
